rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{producto} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['nombre', 'precioMinorista', 'precioMayorista', 'categoria']);
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    match /pedidos/{pedido} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['nombre', 'items', 'total', 'sessionId']);
      allow read: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || request.auth.token.email == 'admin');
      allow update: if request.auth != null
        && request.auth.token.email == 'admin';
      allow delete: if request.auth != null
        && request.auth.token.email == 'admin';
    }
    match /zonasDeEntrega/{zona} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin';
    }
  }
}
